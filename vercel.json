{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "sample.cakra.xyz" }], "destination": "/demo" },
    { "source": "/", "has": [{ "type": "host", "value": "member.cakra.xyz" }], "destination": "/admin" }
  ]
}
