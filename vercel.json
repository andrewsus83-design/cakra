{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "sample.cakra.xyz" }], "destination": "/demo", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "member.cakra.xyz" }], "destination": "/admin", "permanent": false }
  ]
}
